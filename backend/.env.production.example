# EDUCORE - Production Environment Configuration Template
# Copy this to .env on your production server and populate secure credentials

APP_NAME=EDUCORE
APP_ENV=production
APP_KEY=base64:f8mP/fAvNwcpH+YwZ65fiZgxSc/It+eawZz4dUmrVBc=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://educore.gov.ng

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# High-Performance Production Database (PostgreSQL 15+ Recommended)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=educore_ledger
DB_USERNAME=educore_app
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE

# Session & Cache Settings
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.educore.gov.ng
SESSION_SECURE_COOKIE=true

CACHE_STORE=redis
CACHE_PREFIX=educore_cache_

QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Logging
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

# Storage
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=YOUR_AWS_OR_MINIO_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_OR_MINIO_SECRET
AWS_DEFAULT_REGION=af-south-1
AWS_BUCKET=educore-credential-vault
AWS_USE_PATH_STYLE_ENDPOINT=false

# Rate Limiting
RATE_LIMIT_AUTH=15
RATE_LIMIT_VERIFY=60
