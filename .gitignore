# ==============================================================================
# EDUCORE Root .gitignore
# ==============================================================================

# Dependencies
node_modules/
vendor/
/backend/vendor/
/frontend/node_modules/

# Environment files
.env
.env.*
!.env.example
!.env.production.example
/backend/.env
/backend/.env.*
!/backend/.env.example
!/backend/.env.production.example

# SQLite Databases & Local Test DBs
*.sqlite
*.sqlite-journal
/backend/database/*.sqlite
/backend/database/*.sqlite-journal

# Frontend Production Build Artifacts
dist/
/frontend/dist/
*.tsbuildinfo

# Laravel Storage, Cache, and Framework Files
/backend/storage/*.key
/backend/storage/app/*
!/backend/storage/app/.gitignore
/backend/storage/framework/cache/*
!/backend/storage/framework/cache/.gitignore
/backend/storage/framework/sessions/*
!/backend/storage/framework/sessions/.gitignore
/backend/storage/framework/views/*
!/backend/storage/framework/views/.gitignore
/backend/storage/logs/*
!/backend/storage/logs/.gitignore
/backend/bootstrap/cache/*
!/backend/bootstrap/cache/.gitignore

# OS & Editor generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
